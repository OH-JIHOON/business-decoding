---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import TOC from '../components/TOC.astro';
import ShareButtons from '../components/ShareButtons.astro';
import YouTubeEmbed from '../components/YouTubeEmbed.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import PrevNextNav from '../components/PrevNextNav.astro';
import { formatDate } from '../utils/posts';
import { getReadingTime } from '../utils/reading-time';
import { getCanonicalURL, generateJSONLD } from '../utils/seo';

interface Props {
  title: string;
  date: string;
  description: string;
  tags: string[];
  body: string;
  headings: { depth: number; slug: string; text: string }[];
  youtubeId?: string;
  relatedPosts?: any[];
  prevPost?: any;
  nextPost?: any;
}

const { title, date, description, tags, body, headings, youtubeId, relatedPosts = [], prevPost, nextPost } = Astro.props;
const readingTime = getReadingTime(body);
const postUrl = getCanonicalURL(Astro.url.pathname);

const jsonLd = generateJSONLD({
  type: 'BlogPosting',
  title,
  description,
  url: postUrl,
  datePublished: date,
  tags,
});
---

<BaseLayout title={title} description={description} article={{ publishedTime: date, tags }}>
  <article class="container-narrow py-12">
    <Breadcrumbs items={[
      { name: 'Home', href: '/' },
      { name: 'Posts', href: '/posts' },
      { name: title },
    ]} />

    <!-- Post header -->
    <header class="mb-8">
      <div class="flex flex-wrap items-center gap-2 text-sm text-[var(--color-text-light)] mb-3">
        <time datetime={date}>{formatDate(date)}</time>
        <span>·</span>
        <span>{readingTime} 읽기</span>
      </div>
      <h1 class="text-3xl md:text-4xl font-extrabold leading-tight tracking-tight text-[var(--color-primary)] mb-4">
        {title}
      </h1>
      <p class="text-lg text-[var(--color-text-secondary)] leading-relaxed">
        {description}
      </p>
      <div class="flex flex-wrap gap-2 mt-4">
        {tags.map((tag) => (
          <a
            href={`/tags/${tag}`}
            class="inline-block text-xs px-3 py-1 bg-[var(--color-surface-alt)] text-[var(--color-text-secondary)] rounded-full hover:bg-[var(--color-highlight)] hover:text-white transition-all duration-200"
          >
            #{tag}
          </a>
        ))}
      </div>
    </header>

    {youtubeId && <YouTubeEmbed youtubeId={youtubeId} title={title} />}

    <TOC headings={headings} />

    <!-- Post content -->
    <div class="prose">
      <slot />
    </div>

    <!-- Share -->
    <div class="mt-10 pt-6 border-t border-[var(--color-border)]">
      <ShareButtons title={title} url={postUrl} />
    </div>

    <RelatedPosts posts={relatedPosts} />
    <PrevNextNav prev={prevPost} next={nextPost} />
  </article>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</BaseLayout>
