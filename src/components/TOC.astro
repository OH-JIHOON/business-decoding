---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const filteredHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

{filteredHeadings.length > 0 && (
  <nav class="toc mb-8 p-5 bg-[var(--color-surface-alt)] rounded-xl border border-[var(--color-border)]" aria-label="목차">
    <h2 class="text-sm font-semibold text-[var(--color-text)] mb-3 uppercase tracking-wider">목차</h2>
    <ul class="space-y-1.5">
      {filteredHeadings.map((heading) => (
        <li class={heading.depth === 3 ? 'ml-4' : ''}>
          <a
            href={`#${heading.slug}`}
            class="text-sm text-[var(--color-text-secondary)] hover:text-[var(--color-highlight)] transition-colors duration-200 leading-relaxed"
          >
            {heading.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}
